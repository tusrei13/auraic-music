datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playlists Playlist[]
  likes     Like[]
  histories ListeningHistory[]
  follows   Follow[]
}

model Artist {
  id        String   @id @default(uuid())
  name      String
  avatar    String
  listeners Int      @default(0)
  createdAt DateTime @default(now())

  songs     Song[]
  albums    Album[]
  followers Follow[]
}

model Genre {
  id    String  @id @default(uuid())
  name  String  @unique
  image String
  color String?

  songs Song[]
}

model Mood {
  id    String @id @default(uuid())
  title String
  color String
  icon  String

  songs Song[]
}

model Album {
  id          String   @id @default(uuid())
  title       String
  coverImage  String
  releaseYear Int?
  createdAt   DateTime @default(now())

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  songs    Song[]
}

model Song {
  id        Int      @id @default(autoincrement())
  title     String
  audioUrl  String
  hlsUrl    String?
  duration  Int?
  image     String
  lyrics    Json?    
  playCount Int      @default(0)
  createdAt DateTime @default(now())

  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  genreId   String?
  genre     Genre?   @relation(fields: [genreId], references: [id], onDelete: SetNull)

  albumId String?
  album   Album? @relation(fields: [albumId], references: [id], onDelete: SetNull)

  moodId String?
  mood   Mood? @relation(fields: [moodId], references: [id], onDelete: SetNull)

  playlistSongs PlaylistSong[]
  likes         Like[]
  histories     ListeningHistory[]

  @@index([artistId])
  @@index([genreId])
  @@index([albumId])
}

model Playlist {
  id         String   @id @default(uuid())
  name       String
  coverImage String?
  color      String?  @default("from-indigo-600/40 to-purple-600/40")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  songs      PlaylistSong[]
}

model PlaylistSong {
  playlistId String
  songId     Int
  addedAt    DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
}

model Like {
  userId    String
  songId    Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
}

model ListeningHistory {
  id         String   @id @default(uuid())
  userId     String
  songId     Int
  listenedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([userId, listenedAt])
  @@index([songId, listenedAt])
}

model Follow {
  userId    String
  artistId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@index([artistId])
}