generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

enum AnalyticsEventType {
  TRACK_STARTED
  TRACK_COMPLETED
  TRACK_SKIPPED
}

enum IngestionStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String             @id @default(uuid())
  email     String             @unique
  name      String?
  avatar    String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  role      UserRole           @default(USER)
  follows   Follow[]
  likes     Like[]
  jamendoLikes JamendoLike[]
  histories ListeningHistory[]
  playlists Playlist[]
  jamendoHistory JamendoListening[]
  analyticsEvents AnalyticsEvent[]
  ingestionJobs IngestionJob[]
}

model IngestionJob {
  id String @id @default(uuid())
  status IngestionStatus
  source String @default("jamendo")
  startedAt DateTime @default(now())
  finishedAt DateTime?
  imported Int @default(0)
  updated Int @default(0)
  failed Int @default(0)
  errorMessage String?
  createdById String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  @@index([startedAt])
}

model SystemSetting {
  key String @id
  value String
  updatedAt DateTime @updatedAt
  updatedById String?
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String   @db.VarChar(100)
  targetType String?  @db.VarChar(50)
  targetId   String?
  changes    Json?
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Artist {
  id        String   @id @default(uuid())
  name      String
  avatar    String
  listeners Int      @default(0)
  createdAt DateTime @default(now())
  albums    Album[]
  followers Follow[]
  songs     Song[]
}

model Genre {
  id    String  @id @default(uuid())
  name  String  @unique
  image String
  color String?
  songs Song[]
}

model Mood {
  id    String @id @default(uuid())
  title String
  color String
  icon  String
  songs Song[]
}

model Album {
  id          String   @id @default(uuid())
  title       String
  coverImage  String
  releaseYear Int?
  createdAt   DateTime @default(now())
  artistId    String
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  songs       Song[]
}

model Song {
  id            Int                @id @default(autoincrement())
  title         String
  audioUrl      String
  image         String
  lyrics        Json?
  playCount     Int                @default(0)
  createdAt     DateTime           @default(now())
  artistId      String
  genreId       String?
  albumId       String?
  moodId        String?
  duration      Int?
  hlsUrl        String?
  likes         Like[]
  histories     ListeningHistory[]
  playlistSongs PlaylistSong[]
  album         Album?             @relation(fields: [albumId], references: [id])
  artist        Artist             @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre         Genre?             @relation(fields: [genreId], references: [id])
  mood          Mood?              @relation(fields: [moodId], references: [id])

  @@index([artistId])
  @@index([genreId])
  @@index([albumId])
}

model Playlist {
  id           String                @id @default(uuid())
  name         String
  coverImage   String?
  color        String?               @default("from-indigo-600/40 to-purple-600/40")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs        PlaylistSong[]
  jamendoSongs JamendoPlaylistSong[]
}

model PlaylistSong {
  playlistId String
  songId     Int
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
}

model JamendoPlaylistSong {
  id         String   @id @default(uuid())
  playlistId String
  trackId    String
  title      String
  artistName String
  image      String
  audioUrl   String
  duration   Int?
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
}

model Like {
  userId    String
  songId    Int
  createdAt DateTime @default(now())
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
}

model JamendoLike {
  userId     String
  trackId    String
  title      String
  artistName String
  image      String
  audioUrl   String
  duration   Int?
  licenseUrl String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId, createdAt])
}

model ListeningHistory {
  id         String   @id @default(uuid())
  userId     String
  songId     Int
  listenedAt DateTime @default(now())
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, listenedAt])
  @@index([songId, listenedAt])
}

model JamendoListening {
  id         String   @id @default(uuid())
  userId     String
  trackId    String
  title      String
  artistName String
  image      String
  audioUrl   String
  duration   Int?
  listenedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, listenedAt])
  @@index([trackId, listenedAt])
}

model AnalyticsEvent {
  id         String             @id @default(uuid())
  userId     String
  eventType  AnalyticsEventType
  trackId    String
  source     String             @default("unknown")
  title      String             @db.VarChar(300)
  position   Int?
  duration   Int?
  occurredAt DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([trackId, eventType, occurredAt])
}

model Follow {
  userId    String
  artistId  String
  createdAt DateTime @default(now())
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@index([artistId])
}
