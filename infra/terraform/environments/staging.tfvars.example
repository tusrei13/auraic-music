environment          = "staging"
app_name             = "auraic"
aws_region           = "ap-southeast-1"
domain_name          = "staging.auraic.app"
db_name              = "auraic_staging"
db_username          = "auraic_admin"
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
backend_docker_image = "ghcr.io/auraic/backend:staging"
frontend_docker_image = "ghcr.io/auraic/frontend:staging"
